{%- comment -%}
  HALORA — PDP highlights strip.
  A single horizontal line of three markers (icon + short label) rendered
  under the price. Reusable across the whole catalog.

  Content per product is metafield-driven with a sensible default fallback,
  so any product can override without touching Liquid:
    custom.highlight_1  →  natural / quality signal
    custom.highlight_2  →  formulation signal
    custom.highlight_3  →  usage / safety signal

  Icons are semantic to each SLOT (not to the text), so labels can vary
  per product while the visual pattern stays consistent across the catalog.

  Params:
    product   — Product object. Required.
{%- endcomment -%}

{%- liquid
  assign p_metas = product.metafields.custom
  assign h1 = p_metas.highlight_1 | default: '100% Natural Ingredients'
  assign h2 = p_metas.highlight_2 | default: 'Hand-Blended in Lahore'
  assign h3 = p_metas.highlight_3 | default: 'Made in Small Batches'
-%}

<ul class="halora-pdp-highlights" role="list">
  <li class="halora-pdp-highlights__item">
    <svg class="halora-pdp-highlights__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21c-4-1-8-4-8-11 0-2 1-4 2-5 3 1 6 3 8 6 2-3 5-5 8-6 1 1 2 3 2 5 0 7-4 10-8 11z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 21V8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
    <span class="halora-pdp-highlights__label">{{ h1 }}</span>
  </li>
  <li class="halora-pdp-highlights__item">
    <svg class="halora-pdp-highlights__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3c-3 4-6 8-6 12a6 6 0 0012 0c0-4-3-8-6-12z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M9 14a3 3 0 003 3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
    <span class="halora-pdp-highlights__label">{{ h2 }}</span>
  </li>
  <li class="halora-pdp-highlights__item">
    <svg class="halora-pdp-highlights__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7 11V6a1.5 1.5 0 013 0v5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 11V4.5a1.5 1.5 0 013 0V11" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13 11V5.5a1.5 1.5 0 013 0V11" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 8a1.5 1.5 0 013 0v6a7 7 0 01-14 0v-3a1.5 1.5 0 013 0" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="11" cy="16" r="1.1" fill="currentColor"/>
    </svg>
    <span class="halora-pdp-highlights__label">{{ h3 }}</span>
  </li>
</ul>

<style>
  .halora-pdp-highlights {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 22px 0 26px;
    padding: 18px 0;
    border-top: 1px solid var(--color-rule, #D9CFBE);
    border-bottom: 1px solid var(--color-rule, #D9CFBE);
    list-style: none;
  }
  .halora-pdp-highlights__item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    padding: 0 14px;
    border-right: 1px solid rgba(0,0,0,0.06);
    min-width: 0;
  }
  .halora-pdp-highlights__item:first-child { padding-left: 0; }
  .halora-pdp-highlights__item:last-child { border-right: none; padding-right: 0; }
  .halora-pdp-highlights__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: #A85E52;
  }
  .halora-pdp-highlights__label {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.35;
    color: inherit;
  }
  @media (max-width: 640px) {
    .halora-pdp-highlights { gap: 4px; padding: 14px 0; }
    .halora-pdp-highlights__item { padding: 0 8px; gap: 8px; }
    .halora-pdp-highlights__icon { width: 18px; height: 18px; }
    .halora-pdp-highlights__label { font-size: 10.5px; letter-spacing: 0.02em; }
  }
</style>
