{%- comment -%}
  HALORA — Free shipping progress bar.
  Fills based on cart subtotal vs the threshold (PKR 5,000 = 500,000 paisa).
  Renders inside cart-drawer + main-cart-items so Shopify's AJAX section
  refresh redraws it on every add-to-cart / quantity change.
{%- endcomment -%}

{%- liquid
  assign threshold = 500000
  assign remaining = threshold | minus: cart.total_price
  if cart.total_price >= threshold
    assign percent = 100
  else
    assign percent = cart.total_price | times: 100.0 | divided_by: threshold
  endif
-%}

{%- if cart.item_count > 0 -%}
  <div class="halora-cart-progress" data-halora-cart-progress>
    <p class="halora-cart-progress__msg">
      {%- if remaining <= 0 -%}
        You&rsquo;ve unlocked <em>free shipping.</em>
      {%- else -%}
        Add <strong>PKR&nbsp;{{ remaining | money_without_currency | replace: '.00', '' }}</strong> more for <em>free shipping.</em>
      {%- endif -%}
    </p>
    <div class="halora-cart-progress__bar" role="progressbar"
         aria-valuenow="{{ percent | round }}" aria-valuemin="0" aria-valuemax="100"
         aria-label="Free shipping progress">
      <div class="halora-cart-progress__fill" style="width: {{ percent }}%"></div>
    </div>
  </div>
{%- endif -%}
