<footer class="halora-footer color-{{ section.settings.color_scheme }}">
  <div class="halora-footer__grid page-width">
    <div class="halora-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 360 }}" alt="{{ shop.name }}" class="halora-footer__word" width="180" height="42">
      {%- else -%}
        <img src="{{ 'halora-logo.svg' | asset_url }}" alt="{{ shop.name }}" class="halora-footer__word" width="180" height="42">
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}<p class="halora-footer__tag">{{ section.settings.tagline }}</p>{%- endif -%}
      {%- if section.settings.about != blank -%}<p class="halora-footer__about">{{ section.settings.about }}</p>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_col' -%}
        <div class="halora-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h6>{{ block.settings.heading }}</h6>{%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="halora-footer__bottom page-width">
    <p>© {{ shop.name }} {{ 'now' | date: '%Y' }} · Made in Lahore</p>
    <div class="halora-footer__social">
      <a href="https://wa.me/923278804400?text=Hi%20HALORA%20%E2%80%94%20" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Halora footer",
  "tag": "section",
  "class": "section-halora-footer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo (defaults to halora-logo.svg)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Mineral Wellness · Choose Yourself" },
    { "type": "textarea", "id": "about", "label": "About paragraph", "default": "A Pakistani apothecary built around pink Himalayan salt — drawn from the Salt Range, hand-blended in small batches." },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" }
  ],
  "blocks": [
    {
      "type": "menu_col",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Houses" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Halora footer",
    "blocks": [
      { "type": "menu_col", "settings": { "heading": "The Houses", "menu": "main-menu" } },
      { "type": "menu_col", "settings": { "heading": "The House", "menu": "footer" } },
      { "type": "menu_col", "settings": { "heading": "Care", "menu": "footer" } }
    ]
  }]
}
{% endschema %}
