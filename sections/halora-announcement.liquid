<div class="halora-marquee color-{{ section.settings.color_scheme }}" role="region" aria-label="Announcements">
  <div class="halora-marquee__track">
    {%- for block in section.blocks -%}<span>{{ block.settings.text }}</span>{%- endfor -%}
    {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
    {%- for block in section.blocks -%}<span>{{ block.settings.text }}</span>{%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Halora announcement",
  "tag": "section",
  "class": "section-halora-announcement",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" }
  ],
  "blocks": [
    {
      "type": "msg",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Delivery across Pakistan" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{
    "name": "Halora announcement",
    "blocks": [
      { "type": "msg", "settings": { "text": "Delivery across Pakistan" } },
      { "type": "msg", "settings": { "text": "Cash on delivery available" } },
      { "type": "msg", "settings": { "text": "Hand-blended in Lahore" } },
      { "type": "msg", "settings": { "text": "Drawn from the Salt Range" } },
      { "type": "msg", "settings": { "text": "Free shipping over PKR 5,000" } }
    ]
  }]
}
{% endschema %}
