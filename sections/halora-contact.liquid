<section class="halora-contact color-{{ section.settings.color_scheme }}">
  <div class="halora-contact__wrap">
    <div class="halora-contact__form-col">
      {%- form 'contact', class: 'halora-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="halora-contact__success">Thank you. We&rsquo;ll reply within two working days.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="halora-contact__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="halora-contact__row">
          <div class="halora-contact__field">
            <label for="contact-name">Name</label>
            <input id="contact-name" type="text" name="contact[name]" required autocomplete="name">
          </div>
          <div class="halora-contact__field">
            <label for="contact-email">Email</label>
            <input id="contact-email" type="email" name="contact[email]" required autocomplete="email">
          </div>
        </div>

        <div class="halora-contact__row">
          <div class="halora-contact__field">
            <label for="contact-phone">Phone (optional)</label>
            <input id="contact-phone" type="tel" name="contact[phone]" autocomplete="tel">
          </div>
          <div class="halora-contact__field">
            <label for="contact-subject">Subject</label>
            <select id="contact-subject" name="contact[subject]">
              <option>General enquiry</option>
              <option>Order status</option>
              <option>Returns or damage</option>
              <option>Wholesale &amp; stockist</option>
              <option>Press &amp; partnerships</option>
              <option>Care or product question</option>
            </select>
          </div>
        </div>

        <div class="halora-contact__field">
          <label for="contact-order">Order number (if applicable)</label>
          <input id="contact-order" type="text" name="contact[order]" placeholder="e.g. HAL-1042">
        </div>

        <div class="halora-contact__field">
          <label for="contact-body">Your message</label>
          <textarea id="contact-body" name="contact[body]" rows="6" required></textarea>
        </div>

        <button type="submit" class="halora-btn">{{ section.settings.cta_label | default: 'Send Message' }}</button>
      {%- endform -%}
    </div>

    <aside class="halora-contact__side">
      <h6>Direct</h6>
      {%- if section.settings.email != blank -%}
        <div class="halora-contact__item"><p class="label">Email</p><p class="val"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p></div>
      {%- endif -%}
      <div class="halora-contact__item"><p class="label">WhatsApp</p><p class="val"><a href="https://wa.me/923278804400?text=Hi%20HALORA%20%E2%80%94%20" target="_blank" rel="noopener noreferrer">+92 327 8804400</a></p></div>
      {%- if section.settings.studio_label != blank -%}
        <div class="halora-contact__item"><p class="label">Studio</p><p class="val">{{ section.settings.studio_label }}<br><span class="small">{{ section.settings.studio_note }}</span></p></div>
      {%- endif -%}

      {%- if section.settings.hours_heading != blank -%}
        <h6 style="margin-top:3.6rem">{{ section.settings.hours_heading }}</h6>
        {%- if section.settings.hours_weekday != blank -%}<div class="halora-contact__item"><p class="label">Mon – Sat</p><p class="val">{{ section.settings.hours_weekday }}</p></div>{%- endif -%}
        {%- if section.settings.hours_sunday != blank -%}<div class="halora-contact__item"><p class="label">Sunday</p><p class="val">{{ section.settings.hours_sunday }}</p></div>{%- endif -%}
      {%- endif -%}

      <h6 style="margin-top:3.6rem">Quick answers</h6>
      <div class="halora-contact__item"><p class="val"><a href="/pages/faq">Frequently asked questions →</a></p></div>
      <div class="halora-contact__item"><p class="val"><a href="/pages/shipping-returns">Shipping &amp; returns →</a></p></div>
      <div class="halora-contact__item"><p class="val"><a href="/pages/care-guide">Product care guide →</a></p></div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Halora contact",
  "tag": "section",
  "class": "section-halora-contact",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "cta_label", "label": "Submit button label", "default": "Send Message" },
    { "type": "header", "content": "Direct contact" },
    { "type": "text", "id": "email", "label": "Email", "default": "haloraliving@gmail.com" },
    { "type": "text", "id": "studio_label", "label": "Studio location", "default": "Lahore, Pakistan" },
    { "type": "text", "id": "studio_note", "label": "Studio note", "default": "By appointment only" },
    { "type": "header", "content": "Reply hours" },
    { "type": "text", "id": "hours_heading", "label": "Section heading", "default": "Reply hours" },
    { "type": "text", "id": "hours_weekday", "label": "Mon–Sat", "default": "10:00 — 19:00 PKT" },
    { "type": "text", "id": "hours_sunday", "label": "Sunday", "default": "Closed" }
  ],
  "presets": [{ "name": "Halora contact" }]
}
{% endschema %}
